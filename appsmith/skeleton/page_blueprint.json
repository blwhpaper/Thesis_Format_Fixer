{
  "app": {
    "name": "论文格式工具",
    "pages": [
      {
        "name": "工作台首页",
        "sections": [
          {
            "id": "hero",
            "title": "顶部应用标题与当前能力说明",
            "widgets": [
              "页面标题",
              "当前可用能力卡",
              "当前预留能力卡"
            ]
          },
          {
            "id": "entryCards",
            "title": "主入口卡片区",
            "widgets": [
              "单文件处理入口",
              "批量处理预留入口",
              "规则与帮助入口"
            ]
          },
          {
            "id": "quickStart",
            "title": "简短操作步骤",
            "widgets": [
              "四步操作说明",
              "本地预览提示"
            ]
          }
        ]
      },
      {
        "name": "单文件处理页",
        "sections": [
          {
            "id": "submit",
            "title": "文件上传与提交区",
            "widgets": [
              "文件选择器",
              "模式切换按钮组",
              "提交按钮",
              "重试按钮",
              "重置按钮"
            ]
          },
          {
            "id": "status",
            "title": "任务状态区",
            "widgets": [
              "任务状态卡",
              "摘要统计卡"
            ]
          },
          {
            "id": "userSummary",
            "title": "用户摘要区",
            "widgets": [
              "总体状态卡",
              "重点问题列表",
              "建议下一步列表"
            ]
          },
          {
            "id": "details",
            "title": "问题明细区",
            "widgets": [
              "分类问题表格",
              "空状态提示"
            ]
          },
          {
            "id": "downloads",
            "title": "下载区",
            "widgets": [
              "报告下载按钮",
              "修订稿下载按钮",
              "无修订稿提示"
            ]
          }
        ]
      }
    ]
  },
  "bindings": {
    "pageState": {
      "selectedFile": "File | null",
      "selectedMode": "check | fix",
      "currentJobStatus": "idle | submitting | submitted | completed | failed",
      "latestResultPayload": "JobPayload | null",
      "latestArtifacts": "artifacts payload",
      "latestError": "string | null"
    },
    "futureApiSlots": [
      {
        "purpose": "提交单文件检查",
        "method": "POST",
        "endpoint": "/api/jobs/check"
      },
      {
        "purpose": "提交单文件修复",
        "method": "POST",
        "endpoint": "/api/jobs/fix"
      },
      {
        "purpose": "轮询任务结果",
        "method": "GET",
        "endpoint": "/api/jobs/{job_id}"
      }
    ]
  }
}
